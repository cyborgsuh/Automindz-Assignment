# --- Required (live run) ---
APIFY_TOKEN=
AI_ARK_TOKEN=
OPENROUTER_API_KEY=

# Supabase Postgres — use the pooler connection string (recommended for Python):
#   1. Supabase Dashboard → Connect to your project
#   2. Connection Method: "Session pooler" (or "Transaction pooler")
#   3. Type: Python → copy DATABASE_URL from the .env snippet into the line below
#
# IMPORTANT — special characters in the database password:
#   Supabase often generates passwords with $ / # + etc. If you paste the URL as-is,
#   the connection WILL FAIL (password auth error, or "failed to resolve host postgres.xxx").
#   You must URL-encode every special character in the PASSWORD part only:
#     $ → %24    / → %2F    # → %23    + → %2B    @ → %40
#   Example: password  LP$foo/bar  →  LP%24foo%2Fbar
#     postgresql://postgres.[ref]:LP%24foo%2Fbar@aws-0-....pooler.supabase.com:5432/postgres
#   Easier alternative: Supabase → Project Settings → Database → Reset database password
#   to letters and numbers only, then copy the new DATABASE_URL (no encoding needed).
SUPABASE_POOLER_URL=

# --- Optional ---
# Jobs per Apify scrape (default 2)
APIFY_MAX_ITEMS=2

OPENROUTER_ICP_MODEL=perplexity/sonar
OPENROUTER_ICP_FALLBACK_MODEL=openrouter/free
OPENROUTER_HM_MODEL=meta-llama/llama-3.1-8b-instruct

# AI_ARK_BASE_URL=https://api.ai-ark.com/api/developer-portal/v1
# SUPABASE_DB_URL=   # legacy fallback if SUPABASE_POOLER_URL is not set
